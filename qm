<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>QUANTUM MECHANICS // THE WAVEFUNCTION</title>

<style>

@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    overflow:hidden;
    font-family:'Orbitron',sans-serif;
    background:black;
    color:white;
}

/* =========================
   QUANTUM BACKGROUND
========================= */

#quantumField{
    position:fixed;
    inset:0;
    background:
    radial-gradient(circle at center,#101b38 0%,#04060f 70%);
    overflow:hidden;
    z-index:-10;
}

.grid{
    position:absolute;
    width:100%;
    height:100%;
    background-image:
    linear-gradient(rgba(0,255,255,0.04) 1px,transparent 1px),
    linear-gradient(90deg,rgba(0,255,255,0.04) 1px,transparent 1px);
    background-size:60px 60px;
    animation:gridMove 10s linear infinite;
}

@keyframes gridMove{
    from{
        transform:translateY(0px);
    }
    to{
        transform:translateY(60px);
    }
}

.quantumParticle{
    position:absolute;
    border-radius:50%;
    background:#00ffff;
    box-shadow:
    0 0 15px #00ffff,
    0 0 30px rgba(0,255,255,0.5);
    opacity:0.7;
}

.wave{
    position:absolute;
    width:200vw;
    height:220px;
    border-top:2px solid rgba(0,255,255,0.15);
    border-radius:50%;
    animation:waveMove linear infinite;
}

@keyframes waveMove{
    from{
        transform:translateX(-20vw);
    }
    to{
        transform:translateX(0vw);
    }
}

/* =========================
   TOP BAR
========================= */

.topBar{
    position:absolute;
    top:0;
    left:0;
    width:100%;
    padding:18px 24px;
    background:rgba(0,0,0,0.35);
    backdrop-filter:blur(10px);
    border-bottom:1px solid rgba(0,255,255,0.15);
    display:flex;
    justify-content:space-between;
    align-items:center;
    z-index:100;
}

.title{
    font-size:30px;
    font-weight:900;
    color:#00ffff;
    letter-spacing:3px;
    text-shadow:0 0 20px #00ffff;
}

.subtitle{
    font-size:11px;
    color:#8ae6ff;
    margin-top:4px;
}

.status{
    text-align:right;
    font-size:12px;
    color:#88ffff;
    line-height:1.8;
}

/* =========================
   MAIN LAYOUT
========================= */

.container{
    width:100vw;
    height:100vh;
    display:flex;
}

/* =========================
   LEFT PANEL
========================= */

.leftPanel{
    width:70%;
    height:100%;
    position:relative;
}

/* =========================
   CENTRAL QUANTUM DISPLAY
========================= */

.quantumCore{
    position:absolute;
    left:50%;
    top:54%;
    transform:translate(-50%,-50%);
    width:520px;
    height:520px;
    border-radius:50%;
    border:2px solid rgba(0,255,255,0.25);
    box-shadow:
    0 0 30px rgba(0,255,255,0.15),
    inset 0 0 60px rgba(0,255,255,0.05);
    display:flex;
    justify-content:center;
    align-items:center;
}

.probabilityCloud{
    position:absolute;
    width:300px;
    height:300px;
    border-radius:50%;
    background:
    radial-gradient(circle,
    rgba(0,255,255,0.8) 0%,
    rgba(0,255,255,0.15) 40%,
    rgba(0,255,255,0.02) 70%,
    transparent 100%);
    animation:pulse 3s infinite ease-in-out;
}

@keyframes pulse{

    0%{
        transform:scale(1);
        opacity:0.7;
    }

    50%{
        transform:scale(1.15);
        opacity:1;
    }

    100%{
        transform:scale(1);
        opacity:0.7;
    }
}

.coreText{
    position:absolute;
    text-align:center;
    z-index:10;
}

.coreText h1{
    font-size:58px;
    color:#00ffff;
    text-shadow:0 0 20px #00ffff;
}

.coreText p{
    margin-top:12px;
    color:#9defff;
    font-size:13px;
    letter-spacing:2px;
}

/* =========================
   ORBITS
========================= */

.orbit{
    position:absolute;
    border:1px solid rgba(255,255,255,0.08);
    border-radius:50%;
}

.orbit1{
    width:180px;
    height:180px;
    animation:rotate 12s linear infinite;
}

.orbit2{
    width:260px;
    height:260px;
    animation:rotateReverse 20s linear infinite;
}

.orbit3{
    width:360px;
    height:360px;
    animation:rotate 30s linear infinite;
}

@keyframes rotate{
    from{
        transform:rotate(0deg);
    }
    to{
        transform:rotate(360deg);
    }
}

@keyframes rotateReverse{
    from{
        transform:rotate(360deg);
    }
    to{
        transform:rotate(0deg);
    }
}

.electron{
    position:absolute;
    width:14px;
    height:14px;
    background:#00ffff;
    border-radius:50%;
    top:50%;
    left:100%;
    transform:translate(-50%,-50%);
    box-shadow:
    0 0 14px #00ffff,
    0 0 25px rgba(0,255,255,0.5);
}

/* =========================
   QUANTUM CARDS
========================= */

.cards{
    position:absolute;
    bottom:30px;
    left:30px;
    display:grid;
    grid-template-columns:repeat(2,260px);
    gap:18px;
}

.card{
    background:rgba(0,255,255,0.05);
    border:1px solid rgba(0,255,255,0.15);
    border-radius:18px;
    padding:18px;
    backdrop-filter:blur(10px);
    transition:0.25s;
}

.card:hover{
    transform:translateY(-5px);
    box-shadow:0 0 20px rgba(0,255,255,0.2);
}

.card h2{
    color:#00ffff;
    margin-bottom:10px;
    font-size:16px;
}

.card p{
    font-size:12px;
    line-height:1.8;
    color:#ccefff;
}

/* =========================
   RIGHT PANEL
========================= */

.rightPanel{
    width:30%;
    height:100%;
    background:rgba(0,0,0,0.35);
    border-left:1px solid rgba(0,255,255,0.12);
    padding:100px 22px 20px;
    overflow-y:auto;
}

/* =========================
   INFO PANEL
========================= */

.infoBox{
    background:rgba(0,255,255,0.05);
    border:1px solid rgba(0,255,255,0.15);
    border-radius:20px;
    padding:20px;
    margin-bottom:20px;
}

.infoBox h2{
    color:#00ffff;
    margin-bottom:14px;
    font-size:18px;
}

.info{
    line-height:1.9;
    font-size:13px;
    color:#d6f7ff;
}

.highlight{
    color:#00ffff;
}

.equation{
    margin-top:18px;
    padding:14px;
    border-radius:14px;
    background:rgba(0,0,0,0.25);
    text-align:center;
    color:#ffee88;
    font-size:18px;
}

/* =========================
   BUTTONS
========================= */

.buttons{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
    margin-top:18px;
}

button{
    padding:14px;
    border:none;
    border-radius:14px;
    background:#071522;
    border:1px solid #00ffff;
    color:#00ffff;
    cursor:pointer;
    font-family:'Orbitron',sans-serif;
    transition:0.2s;
}

button:hover{
    background:#00ffff;
    color:black;
    box-shadow:0 0 18px #00ffff;
}

/* =========================
   MEASUREMENT EFFECT
========================= */

.measurement{
    position:absolute;
    inset:0;
    background:white;
    opacity:0;
    pointer-events:none;
}

/* =========================
   FOOTER
========================= */

.footer{
    position:absolute;
    bottom:10px;
    width:100%;
    text-align:center;
    font-size:10px;
    letter-spacing:3px;
    color:#667;
}

</style>
</head>

<body>

<div id="quantumField">

    <div class="grid"></div>

</div>

<div class="measurement" id="measurement"></div>

<div class="topBar">

    <div>

        <div class="title">
            ⚛ QUANTUM MECHANICS
        </div>

        <div class="subtitle">
            PROBABILITY • WAVEFUNCTIONS • SUPERPOSITION • UNCERTAINTY
        </div>

    </div>

    <div class="status">

        WAVEFUNCTION STATUS:
        <span id="stateText">SUPERPOSITION</span>

        <br>

        PARTICLE LOCATION:
        <span id="locationText">UNCERTAIN</span>

    </div>

</div>

<div class="container">

    <!-- LEFT -->

    <div class="leftPanel">

        <!-- CORE -->

        <div class="quantumCore">

            <div class="probabilityCloud" id="cloud"></div>

            <div class="orbit orbit1">
                <div class="electron"></div>
            </div>

            <div class="orbit orbit2">
                <div class="electron"></div>
            </div>

            <div class="orbit orbit3">
                <div class="electron"></div>
            </div>

            <div class="coreText">

                <h1>Ψ</h1>

                <p>
                    THE WAVEFUNCTION
                </p>

            </div>

        </div>

        <!-- CARDS -->

        <div class="cards">

            <div class="card">

                <h2>SUPERPOSITION</h2>

                <p>
                    Quantum particles exist in multiple possible states simultaneously until measured.
                </p>

            </div>

            <div class="card">

                <h2>UNCERTAINTY</h2>

                <p>
                    Position and momentum cannot both be known precisely at the same time.
                </p>

            </div>

            <div class="card">

                <h2>WAVE-PARTICLE DUALITY</h2>

                <p>
                    Matter behaves as both localized particles and delocalized waves.
                </p>

            </div>

            <div class="card">

                <h2>ENTANGLEMENT</h2>

                <p>
                    Two particles can share quantum states instantly across vast distances.
                </p>

            </div>

        </div>

    </div>

    <!-- RIGHT -->

    <div class="rightPanel">

        <!-- INFO -->

        <div class="infoBox">

            <h2>QUANTUM OBSERVATORY</h2>

            <div class="info" id="quantumInfo">

                Quantum mechanics describes reality at the smallest scales.

                <br><br>

                Before measurement, particles exist as probability distributions rather than definite objects.

                <br><br>

                Observation collapses the wavefunction into a measurable state.

            </div>

            <div class="equation">
                Ψ(x,t)
            </div>

            <div class="buttons">

                <button onclick="measureParticle()">
                    MEASURE
                </button>

                <button onclick="collapseWave()">
                    COLLAPSE
                </button>

                <button onclick="entangle()">
                    ENTANGLE
                </button>

                <button onclick="randomizeState()">
                    RANDOMIZE
                </button>

            </div>

        </div>

        <!-- EQUATIONS -->

        <div class="infoBox">

            <h2>QUANTUM EQUATIONS</h2>

            <div class="info">

                Schrödinger Equation:

                <div class="equation">
                    iℏ ∂Ψ/∂t = ĤΨ
                </div>

                <br>

                Heisenberg Uncertainty:

                <div class="equation">
                    Δx Δp ≥ ℏ/2
                </div>

                <br>

                Einstein Relation:

                <div class="equation">
                    E = mc²
                </div>

            </div>

        </div>

        <!-- STATES -->

        <div class="infoBox">

            <h2>QUANTUM STATES</h2>

            <div class="info">

                <span class="highlight">GROUND STATE</span>
                → lowest energy configuration

                <br><br>

                <span class="highlight">EXCITED STATE</span>
                → higher energy probability states

                <br><br>

                <span class="highlight">COLLAPSED STATE</span>
                → measurement-defined reality

                <br><br>

                <span class="highlight">ENTANGLED STATE</span>
                → correlated quantum systems

            </div>

        </div>

    </div>

</div>

<div class="footer">
    REALITY IS A PROBABILITY FIELD
</div>

<script>

/* =========================
   QUANTUM PARTICLES
========================= */

const field=document.getElementById("quantumField");

for(let i=0;i<140;i++){

    const p=document.createElement("div");

    p.className="quantumParticle";

    const size=2+Math.random()*6;

    p.style.width=size+"px";
    p.style.height=size+"px";

    p.style.left=Math.random()*100+"vw";
    p.style.top=Math.random()*100+"vh";

    p.style.opacity=Math.random();

    field.appendChild(p);

    animateParticle(p);
}

/* =========================
   PARTICLE MOTION
========================= */

function animateParticle(p){

    let x=parseFloat(p.style.left);
    let y=parseFloat(p.style.top);

    let dx=(Math.random()-0.5)*0.4;
    let dy=(Math.random()-0.5)*0.4;

    function move(){

        x+=dx;
        y+=dy;

        if(x<0 || x>100) dx*=-1;
        if(y<0 || y>100) dy*=-1;

        p.style.left=x+"vw";
        p.style.top=y+"vh";

        requestAnimationFrame(move);
    }

    move();
}

/* =========================
   WAVES
========================= */

for(let i=0;i<6;i++){

    const wave=document.createElement("div");

    wave.className="wave";

    wave.style.top=
    120+i*140+"px";

    wave.style.animationDuration=
    12+i*3+"s";

    field.appendChild(wave);
}

/* =========================
   MEASURE PARTICLE
========================= */

function measureParticle(){

    const measurement=
    document.getElementById("measurement");

    measurement.style.opacity=0.8;

    setTimeout(()=>{

        measurement.style.opacity=0;

    },120);

    document.getElementById("stateText")
    .innerHTML="COLLAPSED";

    document.getElementById("locationText")
    .innerHTML=
    "x=" + (Math.random()*10).toFixed(2);

    document.getElementById("quantumInfo")
    .innerHTML=`

    Observation performed.

    <br><br>

    The wavefunction collapsed into a measurable eigenstate.

    <br><br>

    Before observation, only probabilities existed.

    <br><br>

    Reality emerged through interaction.

    `;
}

/* =========================
   COLLAPSE WAVE
========================= */

function collapseWave(){

    const cloud=
    document.getElementById("cloud");

    cloud.style.transform=
    "scale(0.4)";

    cloud.style.opacity="1";

    document.getElementById("stateText")
    .innerHTML="LOCALIZED";
}

/* =========================
   ENTANGLE
========================= */

function entangle(){

    document.getElementById("stateText")
    .innerHTML="ENTANGLED";

    document.getElementById("quantumInfo")
    .innerHTML=`

    Two quantum systems are now entangled.

    <br><br>

    Their states become fundamentally correlated regardless of distance.

    <br><br>

    Measuring one instantly defines the other.

    <br><br>

    Einstein called this:
    <span class="highlight">
    "spooky action at a distance."
    </span>

    `;
}

/* =========================
   RANDOMIZE
========================= */

function randomizeState(){

    const cloud=
    document.getElementById("cloud");

    cloud.style.transform=
    `scale(${0.8+Math.random()*0.7})`;

    cloud.style.opacity=
    0.4+Math.random()*0.6;

    document.getElementById("stateText")
    .innerHTML="SUPERPOSITION";

    document.getElementById("locationText")
    .innerHTML="UNCERTAIN";
}

</script>

</body>
</html>
